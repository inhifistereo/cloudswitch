AWS_REGION=us-east-1
AWS_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
AWS_VM_DISPLAY_NAME=AWS VM
# Credentials for a scoped-down IAM user (describe/start/stop this instance only).
# Omit these to fall back to the ambient AWS credential chain (e.g. AWS_PROFILE) instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AZURE_ENABLED=false
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_VM_NAME=
AZURE_VM_DISPLAY_NAME=Azure VM
# Service principal credentials (see AZURE_SETUP.md to create one, scoped to just this resource group).
# Omit these to fall back to the ambient Azure credential chain (e.g. `az login`) instead.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

WIREGUARD_PORT=51820

AWS_WIREGUARD_ALLOWED_CIDRS=0.0.0.0/0
AWS_ADMIN_ALLOWED_CIDR=
AWS_EXPECTED_SECURITY_GROUP_ID=

AZURE_WIREGUARD_ALLOWED_CIDRS=0.0.0.0/0
AZURE_ADMIN_ALLOWED_CIDR=
AZURE_EXPECTED_NSG_NAME=
