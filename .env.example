# =============================================================================
# CREDENTIAL HANDLING
#
# Locally, prefer ambient credentials and leave the secret fields below empty:
# `aws sso login` for AWS, `az login` for Azure. Nothing is then stored in this
# project directory at all.
#
# When HOSTING, there is no CLI to log in with, so static credentials become
# necessary. Set them in the platform's encrypted configuration — Azure App
# Service application settings (ideally as Key Vault references), or your
# host's equivalent — NEVER in a .env file that is deployed with the code.
# .gitignore only stops `git add`; it does not stop a folder copy, a backup, a
# zip, or `git add -f`.
#
# Exception worth taking: on Azure App Service, enable a managed identity and
# leave AZURE_CLIENT_ID/SECRET/TENANT_ID empty. DefaultAzureCredential picks it
# up with no code change, and the long-lived client secret stops existing.
# =============================================================================

# --- Host allowlist (CSRF / DNS-rebinding guard in src/lib/csrf.ts) ----------
# Hostnames this app is legitimately reached on. Empty = loopback only
# (127.0.0.1, localhost, ::1), which is correct for local use.
# A hosted deployment MUST set this to its public hostname, e.g.
# ALLOWED_HOSTS=cloudswitch.azurewebsites.net
# It fails closed: if unset on a public host, every API request returns 403.
ALLOWED_HOSTS=

AWS_REGION=us-east-1
AWS_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
AWS_VM_DISPLAY_NAME=AWS VM
# Leave empty to use the ambient AWS credential chain (AWS_PROFILE / SSO).
# Only populate when hosting, via platform config — and scope the IAM user to
# exactly the five actions in the README's Minimum IAM permissions policy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AZURE_ENABLED=false
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_VM_NAME=
AZURE_VM_DISPLAY_NAME=Azure VM
# Leave empty to use the ambient Azure credential chain (`az login`) locally, or
# a managed identity when hosted on Azure — both are preferable to the service
# principal secret below. See docs/azure-setup.md.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

WIREGUARD_PORT=51820

AWS_WIREGUARD_ALLOWED_CIDRS=0.0.0.0/0
AWS_ADMIN_ALLOWED_CIDR=
AWS_EXPECTED_SECURITY_GROUP_ID=

AZURE_WIREGUARD_ALLOWED_CIDRS=0.0.0.0/0
AZURE_ADMIN_ALLOWED_CIDR=
AZURE_EXPECTED_NSG_NAME=
